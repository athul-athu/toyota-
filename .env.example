# Shared environment (repo root) — used by Django server

# Django (optional; runserver enables DEBUG automatically)
# DJANGO_DEBUG=true

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SALARY_BUCKET=salary-slips

# SMTP (Gmail: use App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Toyota Payroll <you@example.com>

# Next.js admin dashboard (admin-dash/.env.local)
# Local dev:
# NEXT_PUBLIC_API_URL=http://localhost:8000
# Vercel production (Environment Variables):
# NEXT_PUBLIC_API_URL=https://toyota-assessment.onrender.com
# Do NOT add /api at the end of the URL.
