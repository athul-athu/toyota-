# Shared environment (repo root) — used by Django server

# Django (optional; runserver enables DEBUG automatically)
# DJANGO_DEBUG=true
# ALLOWED_HOSTS=toyota-assessment.onrender.com,localhost,127.0.0.1

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SALARY_BUCKET=salary-slips

# Email confirmation redirect (Supabase signup); must match Supabase Auth URL settings
FRONTEND_URL=https://toyota-livid.vercel.app
# SUPABASE_EMAIL_REDIRECT_URL=https://toyota-livid.vercel.app/login
# AUTH_REDIRECT_ORIGINS=https://toyota-livid.vercel.app,http://localhost:3000

# Email on Render (recommended — SMTP port 587 is blocked on many hosts)
# Sign up at https://resend.com → API Keys → add a verified domain or use onboarding@resend.dev for testing
RESEND_API_KEY=
RESEND_FROM=Toyota Payroll <onboarding@resend.dev>

# SMTP (local dev only — Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Toyota Payroll <you@example.com>
SMTP_TIMEOUT=15
PAYROLL_EMAIL_BATCH_SIZE=1

# Next.js: see admin-dash/.env.local (NEXT_PUBLIC_API_URL — backend host, no /api suffix)
